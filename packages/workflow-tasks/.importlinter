[importlinter]
root_packages =
    workflow_tasks
include_external_packages = True

[importlinter:contract:tasks_are_independent]
name = tasks must not import the workflow engine
type = forbidden
source_modules = workflow_tasks.tasks
forbidden_modules =
    workflow_tasks.core
    workflow_tasks.devtools

[importlinter:contract:no_external_deps]
name = workflow_tasks must not import tui_toolkit or nanolab
type = forbidden
source_modules = workflow_tasks
forbidden_modules =
    tui_toolkit
    nanolab
