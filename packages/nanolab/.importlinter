[importlinter]
root_packages =
    nanolab
    sonata_tasks
include_external_packages = True

[importlinter:contract:core_is_independent]
name = core must not import product packages
type = forbidden
source_modules = nanolab.core
forbidden_modules =
    nanolab.app
    nanolab.cli
    nanolab.config
    nanolab.functions
    nanolab.plans
    nanolab.tui
    nanolab.workspace

[importlinter:contract:no_runtime_dependency_on_tui]
name = runtime packages must not depend on tui
type = forbidden
source_modules =
    nanolab.cli
    nanolab.config
    nanolab.core
    nanolab.functions
    nanolab.plans
    nanolab.workspace
forbidden_modules = nanolab.tui

[importlinter:contract:sonata_tasks_is_independent]
name = sonata_tasks must not depend on nanolab
type = forbidden
source_modules = sonata_tasks
forbidden_modules = nanolab
