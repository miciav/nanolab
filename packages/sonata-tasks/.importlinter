[importlinter]
root_packages =
    sonata_tasks
include_external_packages = True

[importlinter:contract:no_product_deps]
name = sonata_tasks must not import nanolab or tui_toolkit
type = forbidden
source_modules = sonata_tasks
forbidden_modules =
    nanolab
    tui_toolkit

[importlinter:contract:pure_types_are_logic_free]
name = pure type modules must not import logic modules
type = forbidden
source_modules =
    sonata_tasks.workflow.events
    sonata_tasks.workflow.models
    sonata_tasks.workflow.context
forbidden_modules =
    sonata_tasks.workflow.reporting
    sonata_tasks.workflow.event_builders
